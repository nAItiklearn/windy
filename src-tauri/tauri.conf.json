{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windy",
  "version": "0.1.0",
  "identifier": "app.windy.clipboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Windy",
    "copyright": "MIT License",
    "shortDescription": "A calm clipboard history",
    "longDescription": "Windy keeps your clipboard history one shortcut away. Local, private, fast.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
